{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kittens Game",
  "version": "0.1.0",
  "identifier": "com.nesercode.kittensgame",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8888",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "猫国建设者",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "tray",
        "url": "/tray",
        "title": "猫国建设者",
        "skipTaskbar": true,
        "decorations": false,
        "dragDropEnabled": false,
        "center": false,
        "visible": false,
        "resizable": false,
        "width": 220,
        "height": 280,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
